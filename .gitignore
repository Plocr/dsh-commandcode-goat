# Installed dependencies. The plugin's only runtime dependency is
# @deepseek-ai/schemastery, which the target deployment already has; nothing
# here belongs in the repository.
node_modules/

# Local npm/pnpm state
.npm-cache/
.pnpm-store/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
*.tgz
# Written by the `npm install` the README tells you to run; the repo ships none,
# because the one runtime dependency is a package the target deployment already
# has and its exact patch version is the deployment's to choose.
package-lock.json

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Anything a local smoke test leaves behind
*.log
scratch/
.scratch/
